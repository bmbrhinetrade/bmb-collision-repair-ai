# ceoscan secrets. Copy to .env, fill in what you use, then lock it down:
#     cp .env.example .env && chmod 600 .env                      # Docker, or running as your own user
#     sudo chown root:ceoscan .env && sudo chmod 640 .env         # systemd (the ceoscan user must read it)
# .env is git-ignored and docker-ignored. NEVER commit it and never put secrets in config/*.yaml.
# Variables already set in the environment win over this file.
#
# Format rules (the same file is read by python-dotenv, Docker Compose and systemd):
#   * KEY=value, one per line, no spaces around "=". No quotes needed for normal values.
#   * Comments only on their own line. systemd does NOT support "KEY=value  # comment".
#   * If a value contains spaces, "#", "$" or quotes, wrap it in single quotes: KEY='va$ue'.
#   * Leave a value empty to leave that feature off.

# ===================================================================== X API (required)
# Bearer Token of your app at https://console.x.com (your app -> keys and tokens).
# Read-only access is enough: ceoscan never posts. The X account needs prepaid credits,
# otherwise X answers HTTP 402 CreditsDepleted.
X_BEARER_TOKEN=

# ===================================================================== Claude (recommended)
# API key from the Claude Console: https://platform.claude.com -> API keys.
# Without it every post is scored by the fast regex rules only (noisier alerts).
ANTHROPIC_API_KEY=

# ===================================================================== Push: Pushover
# Used when settings.yaml has alerts.push: pushover (or both).
# API Token of an application you create at https://pushover.net/apps/build
PUSHOVER_APP_TOKEN=
# Your User Key, shown on your dashboard at https://pushover.net after you log in.
PUSHOVER_USER_KEY=

# ===================================================================== Push: ntfy (default)
# Used when settings.yaml has alerts.push: ntfy (default) or both.
# Use a long random topic and subscribe to it in the ntfy phone app. On ntfy.sh anyone who knows
# the topic name can read (and send) your alerts, so treat it like a password. Generate one with:
#     python3 -c "import secrets; print('ceoscan-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
# Optional access token (starts with tk_) for a reserved/protected topic or a self-hosted
# server with authentication. Leave empty for a public ntfy.sh topic.
NTFY_TOKEN=

# ===================================================================== SMS: Twilio (optional)
# Used only when settings.yaml has alerts.sms.enabled: true.
# Account SID (starts with AC) and Auth Token from the Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your SMS-capable Twilio number in E.164 format, e.g. +15551234567.
# US numbers need A2P 10DLC registration (or a verified toll-free number) to deliver.
TWILIO_FROM=
# Your mobile number in E.164 format, e.g. +15557654321.
ALERT_SMS_TO=

# ===================================================================== Email: SMTP (optional)
# Used only when settings.yaml has alerts.email.enabled: true.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com and
# SMTP_PASSWORD = a Google App Password (needs 2-Step Verification), not your normal password.
SMTP_HOST=
# 587 = STARTTLS (default when empty). For 465 (SMTPS) also set alerts.email.use_ssl: true.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address and recipient(s); several recipients may be comma-separated.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ===================================================================== Claude analyst desk (optional)
# Used only when settings.yaml has claude_desk.enabled: true. A Claude Code scheduled task (cloud)
# analyzes strong alerts and helps you decide (decision support only - it never trades).
# 1. At https://claude.ai/code/routines create a task with the prompt from claude/desk_prompt.md
#    (no repository needed), then add an API trigger to it. Give it its own cloud environment with
#    Limited network plus your finance/news domains (README "Set it up", step 7) - not a widened Default.
# 2. Copy the trigger's Fire URL, e.g. https://api.anthropic.com/v1/claude_code/routines/trig_.../fire
CLAUDE_DESK_FIRE_URL=
# 3. Click "Generate token" and copy it right away (shown once; starts with sk-ant-oat01-).
#    Regenerating it in the same panel revokes the old one. This is NOT your ANTHROPIC_API_KEY.
CLAUDE_DESK_TOKEN=
# Then run: python -m ceoscan test-desk

# ===================================================================== Docker Compose only (optional)
# Not secrets. The container runs as this non-root UID/GID so it can write ./data and ./config.
# Default 1000. If `id -u` / `id -g` print something else on your server, uncomment and set them.
# CEOSCAN_UID=1000
# CEOSCAN_GID=1000

# ===================================================================== Deployment overrides (optional)
# Not secrets. They override config/settings.yaml; the Docker image already sets both.
# CEOSCAN_HEALTH_HOST=0.0.0.0          # ops.health_host (default 127.0.0.1 = this machine only)
# CEOSCAN_CONFIG_ERROR_ACTION=wait     # ops.config_error_action: exit (code 2) | wait (stay up idle)
